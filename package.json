{
  "name": "mixcode-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mixcode-pi": "./dist/cli/main.js"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup src/index.ts src/cli/main.ts --format esm --dts --sourcemap --clean",
    "test": "node --test --import tsx test/*.test.ts",
    "test:packages": "node --test --import tsx pi-packages/*/*.test.ts",
    "check": "bun run typecheck && bun run build && bun run test",
    "check:parallel": "bun run typecheck && bun run build && bun run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "fengari": "^0.1.5",
    "fengari-interop": "^0.1.4",
    "strip-json-comments": "^5.0.3",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^24.3.0",
    "patch-package": "^8.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
