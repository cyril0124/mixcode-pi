{
  "name": "mixcode-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mixcode-pi": "./dist/cli/main.js"
  },
  "scripts": {
    "postinstall": "patch-package || true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup src/index.ts src/cli/main.ts --format esm --dts --sourcemap --clean",
    "test": "node --test --import tsx test/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=json-summary --include 'src/**/*.ts' --exclude 'src/cli/main.ts' --check-coverage --lines 95 --branches 90 --functions 95 --statements 95 node --test --import tsx test/*.test.ts",
    "check": "npm run typecheck && npm run build && npm run coverage",
    "check:parallel": "run-p typecheck build lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.79.4",
    "@earendil-works/pi-ai": "^0.79.4",
    "@earendil-works/pi-coding-agent": "^0.79.4",
    "@earendil-works/pi-tui": "^0.79.4",
    "@typescript/native-preview": "^7.0.0-dev.20260513.1",
    "fengari": "^0.1.5",
    "fengari-interop": "^0.1.4",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^24.3.0",
    "c8": "^10.1.3",
    "npm-run-all2": "^8.0.4",
    "patch-package": "^8.0.1",
    "strip-json-comments": "^5.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.5.0"
  }
}
