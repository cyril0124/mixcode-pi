{
  "name": "mixcode-pi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "mpi": "./src/cli/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyril0124/mixcode-pi.git"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail && bun run scripts/install-pi-extensions.ts --postinstall",
    "install:global": "bun install -g .",
    "install:extensions": "bun run scripts/install-pi-extensions.ts --yes",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup",
    "test": "bun test --parallel=$(bun -e 'console.log(Math.min(16, navigator.hardwareConcurrency))') --timeout=60000 test/*.test.ts",
    "test:packages": "bun test --isolate --timeout=60000 pi-packages/*/*.test.ts",
    "check": "bun run typecheck && bun run build && bun run test",
    "check:parallel": "bun run typecheck && bun run build && bun run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@silvia-odwyer/photon-node": "0.3.4",
    "fengari": "^0.1.5",
    "fengari-interop": "^0.1.4",
    "patch-package": "^8.0.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
