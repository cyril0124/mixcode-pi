{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "types": ["bun-types", "node"]
  },
  "include": [
    "src/**/*.ts",
    "pi-packages/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "mixcode-batch.d.ts"
  ],
  "exclude": ["src/cli/binary-entry.ts"]
}
