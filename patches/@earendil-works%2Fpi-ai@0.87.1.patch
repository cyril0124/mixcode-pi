diff --git a/dist/utils/provider-error.js b/dist/utils/provider-error.js
new file mode 100644
index 0000000000000000000000000000000000000000..e7ee00dfb155c57ad6e425d5babcad3022953e35
--- /dev/null
+++ b/dist/utils/provider-error.js
@@ -0,0 +1,17 @@
+/** MIXCODE: notify without letting optional diagnostics replace a provider failure. */
+export function notifyProviderError(observer, error, model) {
+    if (!observer)
+        return;
+    try {
+        const result = observer(error, model);
+        // A void callback may still be implemented by an async function.
+        if (result && typeof result.then === "function") {
+            Promise.resolve(result).catch(() => {
+                // Observer rejection is non-fatal; preserve the provider's terminal result.
+            });
+        }
+    }
+    catch {
+        // Observer failure is non-fatal; preserve the provider's terminal result.
+    }
+}
